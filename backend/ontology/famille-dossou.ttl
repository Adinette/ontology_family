:Mere a owl:Class ;
    rdfs:subClassOf :Parent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Parent ) ] .

:Oncle a owl:Class ;
    rdfs:subClassOf :Frere ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :frereDe ;
                        owl:someValuesFrom :Parent ] ) ] .

:Pere a owl:Class ;
    rdfs:subClassOf :Parent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Parent ) ] .

:Tante a owl:Class ;
    rdfs:subClassOf :Soeur ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :soeurDe ;
                        owl:someValuesFrom :Parent ] ) ] .

:frereDe a owl:ObjectProperty,
