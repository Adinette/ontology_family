    :age "7"^^xsd:int ;
    :enfantDe1 :Jean_AGANGAN,
        :Liliane_LAWINI ;
    :nom "AGANGAN" ;
    :prenom "George" .

:Homme a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:int ;
                                owl:withRestrictions ( [ xsd:minInclusive "21"^^xsd:int ] ) ] ] ) ] .

