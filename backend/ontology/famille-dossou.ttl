@prefix : <http://www.semanticweb.org/dossou/ontologies/2026/famille-dossou#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/dossou/ontologies/2026/famille-dossou> a owl:Ontology .

:BeauPere a owl:Class ;
    rdfs:subClassOf :BeauParent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :BeauParent :Masculin ) ] .

:BelleFille a owl:Class ;
    rdfs:subClassOf :Fille ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :marieA ;
                        owl:someValuesFrom :Fils ] ) ] .

:BelleMere a owl:Class ;
    rdfs:subClassOf :BeauParent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :BeauParent :Feminin ) ] .

:Cousin a owl:Class ;
    rdfs:subClassOf :Enfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Oncle :Tante ) ] ] ) ] .

:Cousine a owl:Class ;
    rdfs:subClassOf :Enfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Oncle :Tante ) ] ] ) ] .

:DemiFrere a owl:Class ;
    rdfs:subClassOf :Frere ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom :BeauParent ] ) ] .

:DemiSoeur a owl:Class ;
    rdfs:subClassOf :Soeur ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom :BeauParent ] ) ] .

:Femme a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:int ;
                                owl:withRestrictions ( [ xsd:minInclusive "21"^^xsd:int ] ) ] ] ) ] .

:Fillette a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:int ;
                                owl:withRestrictions ( [ xsd:maxInclusive "20"^^xsd:int ] ) ] ] ) ] .

:Garcon a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :age ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:int ;
                                owl:withRestrictions ( [ xsd:maxInclusive "20"^^xsd:int ] ) ] ] ) ] .

