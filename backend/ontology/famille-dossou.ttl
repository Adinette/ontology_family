    rdfs:range :Personne ;
    owl:inverseOf :beauEnfantDe .

:parentDe1 a owl:ObjectProperty ;
    rdfs:subPropertyOf :parentDe .

:parentDe2 a owl:ObjectProperty ;
    rdfs:subPropertyOf :parentDe .

:parentDe3 a owl:ObjectProperty ;
    rdfs:subPropertyOf :parentDe .

