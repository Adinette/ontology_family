:Enfant a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom :Personne ] ) ] .

:enfantDe a owl:ObjectProperty ;
    owl:inverseOf :parentDe .

:Feminin a owl:Class ;
    rdfs:subClassOf :Personne ;
    owl:disjointWith :Masculin .

:Masculin a owl:Class ;
    rdfs:subClassOf :Personne .

:Personne a owl:Class .

