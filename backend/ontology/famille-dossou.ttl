    :prenom "Kadukpe" .

:Neveu a owl:Class ;
    rdfs:subClassOf :Fils ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Frere :Soeur ) ] ] ) ] .

:Niece a owl:Class ;
    rdfs:subClassOf :Fille ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :Personne [ a owl:Restriction ;
                        owl:onProperty :enfantDe ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( :Frere :Soeur ) ] ] ) ] .

:PetitFils a owl:Class ;
    rdfs:subClassOf :PetitEnfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :PetitEnfant ) ] .

:PetiteFille a owl:Class ;
    rdfs:subClassOf :PetitEnfant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Feminin :PetitEnfant ) ] .

:enfantDe1 a owl:ObjectProperty ;
    rdfs:domain :PetitEnfant ;
    rdfs:range :Enfant ;
    rdfs:subPropertyOf :enfantDe ;
    owl:inverseOf :parentDe1 .

:enfantDe2 a owl:ObjectProperty ;
    rdfs:domain :Parent ;
    rdfs:range :GrandParent ;
    rdfs:subPropertyOf :enfantDe ;
    owl:inverseOf :parentDe2 .

:enfantDe3 a owl:ObjectProperty ;
    rdfs:domain :Enfant ;
    rdfs:range :Parent ;
    rdfs:subPropertyOf :enfantDe ;
    owl:inverseOf :parentDe3 .

:estDecede a owl:DatatypeProperty ;
    rdfs:domain :Personne ;
    rdfs:range xsd:boolean .

:grandParentDe a owl:ObjectProperty ;
    owl:propertyChainAxiom ( :parentDe :parentDe ) .

:marieA1 a owl:ObjectProperty ;
    rdfs:domain :Pere ;
    rdfs:range :Mere ;
    rdfs:subPropertyOf :marieA .

:marieA2 a owl:ObjectProperty ;
    rdfs:domain :BeauFil ;
    rdfs:range :Fille ;
    rdfs:subPropertyOf :marieA .

:marieA3 a owl:ObjectProperty ;
    rdfs:domain :GrandPere ;
    rdfs:range :GrandMere ;
    rdfs:subPropertyOf :marieA .

:marieA4 a owl:ObjectProperty ;
    rdfs:domain :Pere ;
    rdfs:range :Mere ;
    rdfs:subPropertyOf :marieA .

:nom a owl:DatatypeProperty ;
    rdfs:domain :Personne ;
    rdfs:range xsd:string .

:nomMarital a owl:DatatypeProperty ;
    rdfs:domain :Personne ;
    rdfs:range xsd:string .

:prenom a owl:DatatypeProperty ;
    rdfs:domain :Personne ;
    rdfs:range xsd:string .

:BeauFil a owl:Class ;
    rdfs:subClassOf :Fils ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Masculin :Personne [ a owl:Restriction ;
                        owl:onProperty :marieA ;
                        owl:someValuesFrom :Fille ] ) ] .

